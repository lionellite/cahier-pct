# Copier ce fichier en `.env` à la racine du dépôt.

# --- Backend ---------------------------------------------------------------
# Laisser vide pour travailler en mode démonstration (aucun appel API).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# auto  : live si une clé est présente, sinon mock
# live  : exige une clé, échoue sinon
# mock  : force le mode démonstration
LLM_MODE=auto

CORPUS_PATH=corpus/processed/pct-3e
CORS_ORIGINS=http://localhost:5173
PORT=5000
FLASK_DEBUG=1

# --- Frontend --------------------------------------------------------------
VITE_API_BASE=/api
